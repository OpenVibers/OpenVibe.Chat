# ═══════════════════════════════════════════════════════════════
# openvibe.chat — Environment Configuration
# Copy to .env and fill in values.
# In production this lives at /etc/openvibe/chat.env (0600).
# ═══════════════════════════════════════════════════════════════

# Server (loopback only: nginx sends /ws/chat and the chat REST prefixes here)
PORT=4400
HOST=127.0.0.1
NODE_ENV=development
# The public origin browsers use — chat is served on Live's origin.
BASE_URL=http://localhost:3000
# Proxy hops that set X-Forwarded-For (Cloudflare → nginx → Node = 2), as Live
TRUST_PROXY=2
# Extra origins for WebSocket upgrades / credentialed CORS (Live's are built in)
#ALLOWED_ORIGINS=

# Chat's own database (production: systemd StateDirectory=openvibe-chat)
CHAT_DB_PATH=./data/chat.db
# Chat's caches (101soundboards clips, TTS preview clips). Default: <db dir>/cache
#CHAT_CACHE_DIR=./data/cache

# Identity — OpenVibe.Network (user JWTs and service tokens are RS256 from here)
OV_NETWORK_URL=https://openvibe.network
OV_NETWORK_INTERNAL_URL=http://127.0.0.1:4000
# PEM with the Network public key; unset = fetched from ${OV_NETWORK_INTERNAL_URL}/api/.well-known/jwks
#OV_NETWORK_PUBLIC_KEY=/opt/openvibe.live/data/keys/openvibe-tools-public.pem

# Chat's service principal (client `chat`; create it with Network's
# server/setup/service-principal.js create chat --env-file /etc/openvibe/chat.env)
OV_OAUTH_CLIENT_ID=chat
OV_OAUTH_CLIENT_SECRET=written-by-service-principal-js

# OpenVibe.Live — every Live-owned read and side effect (server/live-context.js)
OV_LIVE_INTERNAL_URL=http://127.0.0.1:3000
#LIVE_TIMEOUT_MS=4000
# Copy Chat's changes into Live's chat tables (read mirror + rollback path). ON from the cutover;
# OFF for rehearsals (and Live refuses mirror writes unless it runs with CHAT_AUTHORITY=chat).
LIVE_MIRROR=0
#LIVE_MIRROR_INTERVAL_MS=1000

# OpenVibe.Events — the outbox relays only when set (otherwise events wait in events_outbox)
#EVENTS_URL=http://127.0.0.1:4300
#EVENTS_RELAY_INTERVAL_MS=5000

# Public origin used in /paste links (Live's SITE_URL)
SITE_URL=https://openvibe.live

# Channel sounds: the SAME directory as Live's (stored rows hold absolute paths into it and Live's
# donation alerts read alert sounds from it). Production: /opt/openvibe.live/data/sounds
SOUNDS_PATH=./data/sounds
#MAX_SOUND_SIZE_KB=2048
#SOUND_DEFAULT_MAX_SECONDS=10
#MAX_SOUNDS_PER_CHANNEL=150
#MAX_SOUNDS_PER_UPLOADER_PER_CHANNEL=10

# Optional diagnostics
#DEBUG_DM_DELIVERY=1
