+effectsRouter.post('/asset-sync', (req, res) => {
+    try {
+        const sync = require('../media-proxy/asset-sync');
+        if (req.body?.op === 'syncSoon') sync.syncSoon();
+        else if (req.body?.op === 'remove-sound') {
